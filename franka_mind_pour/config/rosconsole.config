# rosconsole log4j config.
#
# Levels (low -> high): DEBUG, INFO, WARN, ERROR, FATAL.
# A logger inherits from its parent unless overridden. Override pattern:
#   log4j.logger.ros.<package>=<LEVEL>
#
# Runtime override (no rebuild, takes effect immediately):
#   rosservice call /franka_control/set_logger_level \
#     "logger: 'ros.franka_mind_pour' level: 'warn'"
# or use rqt_logger_level for a GUI.

# Catch-all: everything below WARN is suppressed unless re-enabled below.
log4j.logger.ros=WARN

# Our own code. The controller plugin runs inside the franka controller_manager
# process and logs under this logger. Kept at INFO: it only emits the state
# transitions plus one throttled joint 7 line every 0.5 s.
log4j.logger.ros.franka_mind_pour=INFO

# Third-party packages we bring up.
log4j.logger.ros.controller_manager=WARN
log4j.logger.ros.franka_control=WARN
log4j.logger.ros.franka_hw=WARN
